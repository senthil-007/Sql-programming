SELECT * FROM Books;

SELECT * FROM Books
WHERE Price > 600;

UPDATE Books
SET AvailableCopies = 12
WHERE BookID = 101;

DELETE FROM Books
WHERE BookID = 104;

SELECT *
FROM Books
ORDER BY Price DESC;

SELECT AVG(Price) AS AveragePrice
FROM Books;

SELECT MAX(Price) AS HighestPrice
FROM Books;
